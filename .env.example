APP_NAME=Candidate Experience Automation
APP_VERSION=0.1.0
ENV=development
DATABASE_URL=sqlite:///./candidate_experience.db


HANDOFF_PHONE_NUMBER=+2340000000000
HANDOFF_HOLD_MESSAGE=Please hold while I connect you to a candidate experience officer.

# Background jobs
JOB_TIMEZONE=Africa/Lagos

PUBLIC_BASE_URL=http://localhost:8000

ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_OUTBOUND_AGENT_ID=
ELEVENLABS_OUTBOUND_PHONE_NUMBER_ID=
ELEVENLABS_OUTBOUND_CONCURRENCY_LIMIT=1


SURVEYMONKEY_BASE_URL=https://api.surveymonkey.com/v3
SURVEYMONKEY_ACCESS_TOKEN=your_access_token_here
SURVEYMONKEY_CAMPAIGN_TEMPLATE_SURVEY_ID=
SURVEYMONKEY_CSAT_TEMPLATE_SURVEY_ID=
SURVEYMONKEY_CAMPAIGN_SURVEY_ID=
SURVEYMONKEY_CAMPAIGN_COLLECTOR_ID=
SURVEYMONKEY_CSAT_SURVEY_ID=
SURVEYMONKEY_CSAT_COLLECTOR_ID=
ZOHO_WEBHOOK_TOKEN=


SURVEYMONKEY_CLIENT_ID=
SURVEYMONKEY_CLIENT_SECRET=
SURVEYMONKEY_REDIRECT_URI=http://localhost:8000/auth/surveymonkey/callback
SURVEYMONKEY_WEBHOOK_SECRET=


# Zoho Desk (Helpdesk system of record)
# Accounts/Desk hosts are data-centre specific: .com, .eu, .in, ...
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_DESK_BASE_URL=https://desk.zoho.com/api/v1
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_DEPARTMENT_ID=


KB_READER_TENANT_ID=
KB_READER_CLIENT_ID=

KB_READER_SECRET_ID=
KB_READER_SECRET_VALUE=

# Azure Document Intelligence Read OCR for Helpdesk ticket attachments
HELPDESK_ATTACHMENT_OCR_ENABLED=false
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30

REDIS_URL=redis://localhost:6379/0
RQ_DEFAULT_QUEUE=candidate-experience

INFERENCE_BASE_URL=
INFERENCE_API_KEY=

KB_DIR=kb
CHROMA_DIR=chroma_data

HELPDESK_TAG_EXECUTE=false
HELPDESK_PIPELINE_CRON="*/5 * * * *"
HELPDESK_CONVERSATION_ENABLED=false
HELPDESK_CHECKPOINT_PATH=./data/helpdesk-checkpoints.sqlite
HELPDESK_CUE_REGISTRY_PATH=./config/helpdesk-cues.json
HELPDESK_CONVERSATION_CONTEXT_MESSAGES=20
HELPDESK_AUTOMATION_ASSIGNEE_IDS=
